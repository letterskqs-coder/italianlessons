<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Italiano con Sara 🌸 — Raccontare il Mare (Versione Estesa)</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,600;1,300&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --sand: #f5efe6;
    --warm: #e8d9c4;
    --terracotta: #c4714a;
    --rust: #a85535;
    --sea: #4a7f8f;
    --seafoam: #7fb8c4;
    --dark: #2a2018;
    --mid: #6b5744;
    --light-text: #8a7060;
    --correct: #5a9e6b;
    --wrong: #c45a4a;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--sand);
    color: var(--dark);
    min-height: 100vh;
    font-size: 16px;
    line-height: 1.6;
  }

  /* HEADER */
  .header {
    background: var(--dark);
    color: var(--sand);
    padding: 3rem 2rem;
    position: relative;
    overflow: hidden;
  }
  .header::before {
    content: '';
    position: absolute;
    top: -40px; right: -40px;
    width: 200px; height: 200px;
    border-radius: 50%;
    background: var(--sea);
    opacity: 0.15;
  }
  .header-tag {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--seafoam);
    margin-bottom: 0.5rem;
  }
  .header h1 {
    font-family: 'Fraunces', serif;
    font-size: 2.5rem;
    font-weight: 300;
    line-height: 1.1;
  }
  .header h1 em {
    font-style: italic;
    color: var(--seafoam);
  }

  /* PROGRESS BAR */
  .progress-wrap {
    background: var(--warm);
    padding: 0.8rem 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid #d9c8b4;
    position: sticky;
    top: 0;
    z-index: 1000;
  }
  .progress-bar {
    flex: 1;
    height: 6px;
    background: #d9c8b4;
    border-radius: 3px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: var(--sea);
    transition: width 0.5s ease;
    width: 0%;
  }
  .progress-text { font-size: 0.8rem; font-weight: 600; color: var(--dark); min-width: 100px; }

  /* CONTAINER */
  .container {
    max-width: 850px;
    margin: 0 auto;
    padding: 2rem 1.5rem 6rem;
  }

  .section {
    display: none;
    animation: fadeIn 0.5s ease;
  }
  .section.active { display: block; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* CARDS */
  .card {
    background: white;
    border-radius: 20px;
    padding: 2.5rem;
    margin-bottom: 2rem;
    border: 1px solid var(--warm);
    box-shadow: 0 4px 20px rgba(42,32,24,0.06);
  }

  h2 { font-family: 'Fraunces', serif; font-size: 1.8rem; color: var(--dark); margin-bottom: 1.5rem; }
  h3 { font-family: 'Fraunces', serif; color: var(--sea); margin-top: 1.5rem; margin-bottom: 1rem; }

  .theory-box {
    background: #fdfaf5;
    border-left: 4px solid var(--sea);
    padding: 1.5rem;
    margin: 1.5rem 0;
    border-radius: 0 12px 12px 0;
  }

  /* VERB TABLES */
  .verb-comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .v-table {
    background: var(--sand);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .v-table h4 {
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    color: var(--mid);
  }

  .v-row {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .v-it { font-weight: 600; color: var(--sea); }

  /* EXERCISES */
  .ex-box {
    margin-top: 2rem;
    padding-top: 1rem;
  }

  .input-group {
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: #fcfcfc;
    border-radius: 10px;
  }

  .label-en {
    display: block;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--light-text);
    margin-bottom: 0.5rem;
  }

  input[type="text"] {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 2px solid var(--warm);
    border-radius: 10px;
    font-family: inherit;
    font-size: 1rem;
    outline: none;
    transition: all 0.2s;
  }

  input[type="text"]:focus {
    border-color: var(--sea);
    background: #fdfaf5;
  }

  /* BUTTONS */
  .nav-row {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
  }

  .btn {
    padding: 1rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    border: none;
    font-family: inherit;
  }

  .btn-next { background: var(--dark); color: var(--sand); }
  .btn-next:hover { background: var(--terracotta); }
  
  .btn-check {
    background: var(--sea);
    color: white;
    margin-top: 1rem;
  }

  .feedback {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 10px;
    display: none;
    font-size: 0.9rem;
  }

  .chip {
    display: inline-block;
    background: white;
    border: 2px solid var(--warm);
    padding: 0.6rem 1.2rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    margin: 5px;
    transition: all 0.2s;
  }

  .chip:hover { border-color: var(--sea); background: var(--sand); }

  textarea {
    width: 100%;
    height: 120px;
    padding: 1rem;
    border-radius: 15px;
    border: 2px solid var(--warm);
    font-family: inherit;
    resize: none;
  }
</style>
</head>
<body>

<div class="progress-wrap">
  <div class="progress-bar"><div class="progress-fill" id="progressFill"></div></div>
  <div class="progress-text" id="progressText">Introduzione</div>
</div>

<div class="header">
  <div class="header-tag">Unità 10 — 16 Aprile 2026</div>
  <h1>L'Imperfetto:<br><em>Storytelling e Meteo</em></h1>
</div>

<div class="container">

  <div class="section active" id="sec0">
    <div class="card">
      <h2>Com'era il mare ieri? 🌊</h2>
      <p>Mentre il <strong>Passato Prossimo</strong> descrive un'azione specifica (es. "Abbiamo salpato"), l'<strong>Imperfetto</strong> serve per descrivere lo <em>sfondo</em> della tua storia.</p>
      
      <div class="theory-box">
        <strong>Perché ti serve?</strong> Per raccontare ai tuoi clienti com'era il tempo l'anno scorso, come apparivano le isole all'alba o com'era la tua vita prima di fare la skipper.
      </div>

      <p>Oggi impareremo a coniugare i verbi "essere" e "avere" e le azioni che facevi ripetutamente in mare.</p>
    </div>

    <div class="nav-row">
      <span></span>
      <button class="btn btn-next" onclick="go(1)">Inizia la teoria →</button>
    </div>
  </div>

  <div class="section" id="sec1">
    <div class="card">
      <h2>1. I Pilastri: Essere e Avere</h2>
      <p>Questi verbi sono fondamentali per descrivere il meteo e le sensazioni nel passato.</p>

      <div class="verb-comparison">
        <div class="v-table">
          <h4>ESSERE (To be)</h4>
          <div class="v-row"><span>Io</span><span class="v-it">ero</span></div>
          <div class="v-row"><span>Lui/Lei</span><span class="v-it">era</span></div>
          <div class="v-row"><span>Noi</span><span class="v-it">eravamo</span></div>
          <div class="v-row"><span>Loro</span><span class="v-it">erano</span></div>
        </div>
        <div class="v-table">
          <h4>AVERE (To have)</h4>
          <div class="v-row"><span>Io</span><span class="v-it">avevo</span></div>
          <div class="v-row"><span>Lui/Lei</span><span class="v-it">aveva</span></div>
          <div class="v-row"><span>Noi</span><span class="v-it">avevamo</span></div>
          <div class="v-row"><span>Loro</span><span class="v-it">avevano</span></div>
        </div>
      </div>

      <div class="theory-box">
        <strong>Esempio Meteo:</strong> "Ieri il cielo <em>era</em> blu e non <em>avevamo</em> nuvole."
      </div>
    </div>

    <div class="nav-row">
      <button class="btn" style="background:var(--warm)" onclick="go(0)">← Indietro</button>
      <button class="btn btn-next" onclick="go(2)">Esercizi Parte 1 →</button>
    </div>
  </div>

  <div class="section" id="sec2">
    <div class="card">
      <h2>2. Descrivi la Barca e il Meteo</h2>
      <p>Completa le descrizioni usando l'imperfetto di <strong>Essere</strong> o <strong>Avere</strong>.</p>

      <div class="ex-box">
        <div class="input-group">
          <span class="label-en">"Yesterday the sea (to be) very calm."</span>
          <input type="text" id="ex2_1" placeholder="Essere -> ...">
        </div>
        <div class="input-group">
          <span class="label-en">"The clients (to have) many questions."</span>
          <input type="text" id="ex2_2" placeholder="Avere -> ...">
        </div>
        <div class="input-group">
          <span class="label-en">"The boat (to be) ready at eight."</span>
          <input type="text" id="ex2_3" placeholder="Essere -> ...">
        </div>
        <div class="input-group">
          <span class="label-en">"We (to have) sun all day."</span>
          <input type="text" id="ex2_4" placeholder="Avere -> ...">
        </div>
        <div class="input-group">
          <span class="label-en">"The islands (to be) beautiful at sunset."</span>
          <input type="text" id="ex2_5" placeholder="Essere -> ...">
        </div>
        <div class="input-group">
          <span class="label-en">"You (plural/voi) (to be) very tired after the tour."</span>
          <input type="text" id="ex2_6" placeholder="Essere -> ...">
        </div>
        
        <button class="btn btn-check" onclick="checkSec2()">Controlla Blocco 1</button>
        <div id="fb2" class="feedback"></div>
      </div>
    </div>

    <div class="nav-row">
      <button class="btn" style="background:var(--warm)" onclick="go(1)">← Teoria</button>
      <button class="btn btn-next" onclick="go(3)">Le Azioni Abituali →</button>
    </div>
  </div>

  <div class="section" id="sec3">
    <div class="card">
      <h2>3. Le azioni che si ripetono</h2>
      <p>L'imperfetto si usa per azioni che facevi regolarmente (es. "L'anno scorso <em>navigavo</em> ogni giorno").</p>

      <div class="v-table" style="margin: 1.5rem 0;">
        <div class="v-row"><span>-ARE (Navigare)</span><span class="v-it">Navigavo / Navigava / Navigavamo</span></div>
        <div class="v-row"><span>-ERE (Vedere)</span><span class="v-it">Vedevo / Vedeva / Vedevamo</span></div>
        <div class="v-row"><span>-IRE (Partire)</span><span class="v-it">Partivo / Partiva / Partivamo</span></div>
      </div>

      <div class="ex-box">
        <h3>Esercizio: Cosa facevi l'anno scorso?</h3>
        <div class="input-group">
          <span class="label-en">"I (to work) at the port."</span>
          <input type="text" id="ex3_1" placeholder="Lavorare -> ...">
        </div>
        <div class="input-group">
          <span class="label-en">"We (to depart) always at 9:00."</span>
          <input type="text" id="ex3_2" placeholder="Partire -> ...">
        </div>
        <div class="input-group">
          <span class="label-en">"Sara (to check) the engine every morning."</span>
          <input type="text" id="ex3_3" placeholder="Controllare -> ...">
        </div>
        <div class="input-group">
          <span class="label-en">"The sun (to shine) bright during July."</span>
          <input type="text" id="ex3_4" placeholder="Splendere -> ...">
        </div>
        <button class="btn btn-check" onclick="checkSec3()">Controlla Blocco 2</button>
        <div id="fb3" class="feedback"></div>
      </div>
    </div>

    <div class="nav-row">
      <button class="btn" style="background:var(--warm)" onclick="go(2)">← Indietro</button>
      <button class="btn btn-next" onclick="go(4)">Scenario Storytelling →</button>
    </div>
  </div>

  <div class="section" id="sec4">
    <div class="card">
      <h2>4. Descrivere il Passato ai Clienti</h2>
      <p>Usa queste parole per rendere il tuo racconto più autentico.</p>

      <div class="word-pool">
        <div class="chip" onclick="addText('splendeva')">splendeva (shined)</div>
        <div class="chip" onclick="addText('soffiava')">soffiava (blew)</div>
        <div class="chip" onclick="addText('c\'era')">c'era (there was)</div>
        <div class="chip" onclick="addText('faceva')">faceva (it was/did)</div>
      </div>

      <div class="ex-box">
        <h3>Esercizio: Completa il racconto del meteo</h3>
        <div class="input-group">
          <p>"Ieri il meteo era perfetto. Il sole <input type="text" id="ex4_1" style="width: 150px;">. Il vento <input type="text" id="ex4_2" style="width: 150px;"> leggero e non <input type="text" id="ex4_3" style="width: 150px;"> onde alte."</p>
        </div>
        <button class="btn btn-check" onclick="checkSec4()">Verifica Racconto</button>
        <div id="fb4" class="feedback"></div>
      </div>
    </div>

    <div class="nav-row">
      <button class="btn" style="background:var(--warm)" onclick="go(3)">← Indietro</button>
      <button class="btn btn-next" onclick="go(5)">Sfida Finale →</button>
    </div>
  </div>

  <div class="section" id="sec5">
    <div class="card">
      <h2>5. La tua storia da Skipper 📖</h2>
      <p>Pensa a un tour dell'estate scorsa. Com'era la giornata? Cosa facevano i clienti?</p>
      
      <div class="theory-card" style="margin-top: 1.5rem;">
        <h3>🗣️ Sfida per Sara:</h3>
        <p>Scrivi 5 frasi usando l'imperfetto per descrivere un ricordo in barca. Usa verbi come: <em>era, aveva, navigavamo, nuotavano, faceva</em>.</p>
        <textarea id="final_story" placeholder="Esempio: L'anno scorso navigavamo spesso vicino a Osljak. Il mare era trasparente..."></textarea>
        <button class="btn btn-check" onclick="alert('Ottimo lavoro! Fai leggere questo racconto a Kate!')">Invia a Kate</button>
      </div>
    </div>

    <div class="nav-row">
      <button class="btn" style="background:var(--warm)" onclick="go(4)">← Indietro</button>
      <button class="btn btn-next" onclick="go(6)">Risultati →</button>
    </div>
  </div>

  <div class="section" id="sec6">
    <div class="score-wrap" style="text-align: center;">
      <div class="score-big" id="finalScore" style="color: var(--sea);">100%</div>
      <div class="score-label">Completato</div>
      <div class="score-msg" style="font-family: Fraunces; font-size: 1.5rem;">Bravissima Narratrice! 🌸</div>
      <p class="score-sub">Ora sai come incantare i tuoi passeggeri con i racconti del mare.</p>
      <button class="btn" style="background: var(--sea); color: white; margin-top: 2rem;" onclick="location.reload()">🔄 Ricomincia lezione</button>
    </div>
  </div>

</div>

<script>
  let current = 0;
  const total = 7;

  function go(n) {
    document.getElementById(`sec${current}`).classList.remove('active');
    document.getElementById(`sec${n}`).classList.add('active');
    current = n;
    updateProgress();
    window.scrollTo(0,0);
  }

  function updateProgress() {
    const pct = (current / (total - 1)) * 100;
    document.getElementById('progressFill').style.width = pct + '%';
    const labels = ["Intro", "Essere/Avere", "Pratica 1", "Abitudini", "Storytelling", "Sfida", "Fine"];
    document.getElementById('progressText').innerText = labels[current];
  }

  function checkSec2() {
    const r = [
      document.getElementById('ex2_1').value.trim().toLowerCase(),
      document.getElementById('ex2_2').value.trim().toLowerCase(),
      document.getElementById('ex2_3').value.trim().toLowerCase(),
      document.getElementById('ex2_4').value.trim().toLowerCase(),
      document.getElementById('ex2_5').value.trim().toLowerCase(),
      document.getElementById('ex2_6').value.trim().toLowerCase()
    ];
    const fb = document.getElementById('fb2');
    if(r[0]==="era" && r[1]==="avevano" && r[2]==="era" && r[3]==="avevamo" && r[4]==="erano" && r[5]==="eravate") {
      showFb(fb, true, "Ottimo lavoro con Essere e Avere!");
    } else {
      showFb(fb, false, "Controlla le coniugazioni di Essere e Avere.");
    }
  }

  function checkSec3() {
    const r = [
      document.getElementById('ex3_1').value.trim().toLowerCase(),
      document.getElementById('ex3_2').value.trim().toLowerCase(),
      document.getElementById('ex3_3').value.trim().toLowerCase(),
      document.getElementById('ex3_4').value.trim().toLowerCase()
    ];
    const fb = document.getElementById('fb3');
    if(r[0]==="lavoravo" && r[1]==="partivamo" && r[2]==="controllava" && r[3]==="splendeva") {
      showFb(fb, true, "Bravissima! Hai capito come formare l'imperfetto.");
    } else {
      showFb(fb, false, "Controlla le desinenze: -avo, -evo, -ivo.");
    }
  }

  function checkSec4() {
    const r1 = document.getElementById('ex4_1').value.trim().toLowerCase();
    const r2 = document.getElementById('ex4_2').value.trim().toLowerCase();
    const r3 = document.getElementById('ex4_3').value.trim().toLowerCase();
    const fb = document.getElementById('fb4');
    if(r1==="splendeva" && r2==="soffiava" && r3.includes("c'erano")) {
      showFb(fb, true, "Il racconto è perfetto!");
    } else {
      showFb(fb, false, "Usa: splendeva, soffiava, c'erano.");
    }
  }

  function showFb(el, correct, msg) {
    el.innerHTML = (correct ? "✅ " : "❌ ") + msg;
    el.className = "feedback show";
    el.style.background = correct ? "#eef6f0" : "#fdf0ee";
    el.style.color = correct ? "#3a7a4a" : "#8a3030";
  }

  function addText(word) {
    alert("Copia questa parola nell'esercizio: " + word);
  }
</script>

</body>
</html>
