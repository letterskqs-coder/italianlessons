<!-- SCRIPT: FUNZIONI INTERATTIVE -->
<script>
  // Cambio tab
  function showTab(id, btn) {
    document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    const target = document.getElementById(id);
    if (target) target.classList.add('active');
    if (btn) btn.classList.add('active');
  }

  // Validatore generico
  function validate(id, correct) {
    const el = document.getElementById(id);
    if (!el) return false;
    const ok = el.value.trim().toLowerCase() === correct.toLowerCase();
    el.className = ok ? 'correct' : 'wrong';
    return ok;
  }

  // U1: vocabolario borghi
  function checkU1Vocab() {
    const r = [
      validate('u1v1','borgo'),
      validate('u1v2','ponte'),
      validate('u1v3','campanile'),
      validate('u1v4','mare')
    ];
    const msg = document.getElementById('msg-u1v');
    msg.style.display = 'block';
    msg.innerHTML = r.every(Boolean)
      ? "Perfetto! Hai il vocabolario base per parlare dei borghi."
      : "Qualche parola è da rivedere. Pensa alle immagini: paese, ponte, campanile, mare.";
    msg.style.color = r.every(Boolean) ? "var(--green)" : "var(--red)";
  }

  // U2: treni
  function checkU2Treni() {
    const r = [
      validate('u2t1','binario'),
      validate('u2t2','ritardo'),
      validate('u2t3','arrivo'),
      validate('u2t4','partenza')
    ];
    const msg = document.getElementById('msg-u2t');
    msg.style.display = 'block';
    msg.innerHTML = r.every(Boolean)
      ? "Ottimo! Sei pronta a leggere un tabellone dei treni."
      : "Riprova: pensa a cosa vedi in stazione (binario, ritardo, partenza, arrivo).";
    msg.style.color = r.every(Boolean) ? "var(--green)" : "var(--red)";
  }

  // U2: TheFork
  function checkU2Fork() {
    const r = [
      validate('u2f1','prenotare'),
      validate('u2f2','sconto'),
      validate('u2f3','recensioni'),
      validate('u2f4','orario')
    ];
    const msg = document.getElementById('msg-u2f');
    msg.style.display = 'block';
    msg.innerHTML = r.every(Boolean)
      ? "Perfetto! Puoi prenotare una cena senza paura."
      : "Controlla: prenotare, sconto, recensioni, orario.";
    msg.style.color = r.every(Boolean) ? "var(--green)" : "var(--red)";
  }

  // U2: EasyPark
  function checkU2Park() {
    const r = [
      validate('u2p1','strisce blu'),
      validate('u2p2','tariffa oraria'),
      validate('u2p3','prolungare')
    ];
    const msg = document.getElementById('msg-u2p');
    msg.style.display = 'block';
    msg.innerHTML = r.every(Boolean)
      ? "Benissimo! Puoi parcheggiare come una persona del posto."
      : "Rivedi: strisce blu, tariffa oraria, prolungare.";
    msg.style.color = r.every(Boolean) ? "var(--green)" : "var(--red)";
  }

  // U3: caffè — al banco / al tavolo
  function checkU3Caffe() {
    const r = [
      validate('u3c1','banco'),
      validate('u3c2','tavolo')
    ];
    const msg = document.getElementById('msg-u3c');
    msg.style.display = 'block';
    msg.innerHTML = r.every(Boolean)
      ? "Perfetto! Sai dove bere il caffè a seconda della situazione."
      : "Ricorda: al banco = veloce, al tavolo = più caro ma rilassato.";
    msg.style.color = r.every(Boolean) ? "var(--green)" : "var(--red)";
  }

  // U3: dialogo bar
  function checkU3Dialogo() {
    const r = [
      validate('u3d1','vorrei'),
      validate('u3d2','banco')
    ];
    const msg = document.getElementById('msg-u3d');
    msg.style.display = 'block';
    msg.innerHTML = r.every(Boolean)
      ? "Dialogo naturale! Puoi ordinare un caffè senza problemi."
      : "Riprova: 'Vorrei un cappuccino' e 'al banco'.";
    msg.style.color = r.every(Boolean) ? "var(--green)" : "var(--red)";
  }

  // U4: parole trasparenti
  function checkU4Vocab() {
    const r = [
      validate('u4v1','situazione'),
      validate('u4v2','cultura'),
      validate('u4v3','storia'),
      validate('u4v4','regione')
    ];
    const msg = document.getElementById('msg-u4v');
    msg.style.display = 'block';
    msg.innerHTML = r.every(Boolean)
      ? "Bravissima! Il tuo cervello multilingue funziona alla grande."
      : "Riprova: pensa alle parole inglesi/tedesche e alla loro forma italiana.";
    msg.style.color = r.every(Boolean) ? "var(--green)" : "var(--red)";
  }

  // U5: arte — Cristo Velato
  function checkU5Vocab() {
    const r = [
      validate('u5v1','scultura'),
      validate('u5v2','marmo'),
      validate('u5v3','vero')
    ];
    const msg = document.getElementById('msg-u5v');
    msg.style.display = 'block';
    msg.innerHTML = r.every(Boolean)
      ? "Perfetto! Hai il vocabolario base per parlare di quest’opera."
      : "Rivedi: scultura, marmo, vero.";
    msg.style.color = r.every(Boolean) ? "var(--green)" : "var(--red)";
  }

  // U7: connettori
  function checkU7Connettori() {
    const r = [
      validate('u7c1','quindi'),
      validate('u7c2','quindi'),
      validate('u7c3','poi'),
      validate('u7c4','perché'),
      validate('u7c5','alla fine')
    ];
    const msg = document.getElementById('msg-u7c');
    msg.style.display = 'block';
    msg.innerHTML = r.every(Boolean)
      ? "Connettori perfetti! Le tue storie hanno una struttura naturale."
      : "Riprova: pensa a causa (perché), conseguenza (quindi), sequenza (poi), conclusione (alla fine).";
    msg.style.color = r.every(Boolean) ? "var(--green)" : "var(--red)";
  }

  // U8: test narrativo
  function checkU8Test() {
    const r = [
      validate('u8t1','binario'),
      validate('u8t2','ritardo'),
      validate('u8t3','poi'),
      validate('u8t4','banco'),
      validate('u8t5','poi'),
      validate('u8t6','prenotare'),
      validate('u8t7','sconto'),
      validate('u8t8','marmo'),
      validate('u8t9','alla fine')
    ];
    const msg = document.getElementById('msg-u8t');
    msg.style.display = 'block';
    msg.innerHTML = r.every(Boolean)
      ? "Test narrativo completato! Hai usato viaggio, app, caffè e arte in modo coerente."
      : "Qualche parola è da rivedere. Ripensa alle unità: treni, bar, app, arte, connettori.";
    msg.style.color = r.every(Boolean) ? "var(--green)" : "var(--red)";
  }
</script>
