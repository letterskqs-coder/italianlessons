<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sara: Masterclass B1 — 30 Esercizi</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #FAF7F2; --ink: #1B3A5C; --lake: #2A7BBF; --gold: #C9942A;
    --green: #3A7A52; --red: #B84040; --border: rgba(27, 58, 92, 0.1);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'DM Sans', sans-serif; background: var(--cream); color: var(--ink); line-height: 1.6; }
  .hero { background: var(--ink); color: white; padding: 40px 20px; text-align: center; clip-path: ellipse(150% 100% at 50% 0%); }
  .hero h1 { font-family: 'Playfair Display', serif; font-size: 28px; }
  .wrapper { max-width: 800px; margin: 0 auto; padding: 20px; }
  
  .tab-nav { display: flex; gap: 5px; margin-bottom: 20px; overflow-x: auto; padding: 5px; }
  .tab-btn { flex: 1; min-width: 140px; padding: 10px; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; background: white; color: var(--ink); border: 1px solid var(--border); }
  .tab-btn.active { background: var(--lake); color: white; }

  .section { display: none; }
  .section.active { display: block; }

  .card { background: white; border-radius: 12px; padding: 20px; margin-bottom: 20px; shadow: 0 4px 15px rgba(0,0,0,0.05); border: 1px solid var(--border); }
  h3 { font-family: 'Playfair Display', serif; margin-bottom: 15px; color: var(--lake); border-bottom: 2px solid var(--gold); display: inline-block; }
  
  .ex-grid { display: grid; gap: 15px; }
  .ex-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 10px; background: #f9fbfd; border-radius: 8px; }
  .ex-num { font-weight: 700; color: var(--gold); min-width: 25px; }
  
  input { border: none; border-bottom: 2px solid var(--lake); background: transparent; padding: 2px 5px; width: 120px; text-align: center; font-weight: 600; color: var(--ink); outline: none; }
  input.ok { border-bottom-color: var(--green); color: var(--green); }
  input.no { border-bottom-color: var(--red); color: var(--red); }

  .btn-all { background: var(--ink); color: white; padding: 15px; width: 100%; border: none; border-radius: 10px; font-weight: 700; cursor: pointer; margin-top: 10px; transition: 0.3s; }
  .btn-all:hover { background: var(--gold); }
  
  .score-disp { margin-top: 15px; font-weight: 700; text-align: center; display: none; padding: 10px; border-radius: 8px; }
</style>
</head>
<body>

<div class="hero">
  <h1>⚓ Sara: Training Intensivo B1</h1>
  <p>Lezioni 13 & 14 — 30 Esercizi di consolidamento </p>
</div>

<div class="wrapper">
  <div class="tab-nav">
    <button class="tab-btn active" onclick="showTab('tab1')">1. Il Condizionale (10)</button>
    <button class="tab-btn" onclick="showTab('tab2')">2. Preposizioni (10)</button>
    <button class="tab-btn" onclick="showTab('tab3')">3. Logica di Bordo (10)</button>
  </div>

  <div id="tab1" class="section active">
    <div class="card">
      <h3>Richieste Gentili ai Passeggeri</h3>
      <p style="font-size: 13px; margin-bottom: 15px;">Usa il condizionale presente (vorrei, potrebbe, farebbe, ecc.).</p>
      <div class="ex-grid" id="grid1">
        </div>
      <button class="btn-all" onclick="checkGroup(1)">Verifica Condizionale</button>
      <div id="score1" class="score-disp"></div>
    </div>
  </div>

  <div id="tab2" class="section">
    <div class="card">
      <h3>Localizzazione Attrezzatura</h3>
      <p style="font-size: 13px; margin-bottom: 15px;">Inserisci la preposizione articolata corretta (nella, sul, dallo, ecc.).</p>
      <div class="ex-grid" id="grid2"></div>
      <button class="btn-all" onclick="checkGroup(2)">Verifica Preposizioni</button>
      <div id="score2" class="score-disp"></div>
    </div>
  </div>

  <div id="tab3" class="section">
    <div class="card">
      <h3>Programma e Sicurezza</h3>
      <p style="font-size: 13px; margin-bottom: 15px;">Completa con il Futuro Semplice per il briefing.</p>
      <div class="ex-grid" id="grid3"></div>
      <button class="btn-all" onclick="checkGroup(3)">Verifica Briefing</button>
      <div id="score3" class="score-disp"></div>
    </div>
  </div>
</div>

<script>
  const data = {
    g1: [
      {q: "Mi (potere) ___ dare la cima?", a: "potrebbe"},
      {q: "Io (volere) ___ un bicchiere d'acqua.", a: "vorrei"},
      {q: "Noi (dovere) ___ chiudere il tendalino.", a: "dovremmo"},
      {q: "Vi (piacere) ___ fare una sosta?", a: "piacerebbe"},
      {q: "Lo skipper (preferire) ___ partire ora.", a: "preferirebbe"},
      {q: "(Potere) ___ spostarvi a sinistra?", a: "potreste"},
      {q: "Io (mangiare) ___ volentieri un tagliere.", a: "mangerei"},
      {q: "Non (dovere) ___ correre sulla barca.", a: "dovrebbe"},
      {q: "Cosa (volere) ___ fare voi?", a: "vorreste"},
      {q: "Si (sedere) ___ qui, per favore.", a: "siederebbe"}
    ],
    g2: [
      {q: "Il giubbotto è (in + la) ___ cabina.", a: "nella"},
      {q: "Sali (su + la) ___ passerella.", a: "sulla"},
      {q: "Il sapone è (in + il) ___ bagno.", a: "nel"},
      {q: "Guarda (a + il) ___ timone.", a: "al"},
      {q: "Vieni (da + lo) ___ skipper.", a: "dallo"},
      {q: "Le chiavi sono (su + il) ___ tavolo.", a: "sul"},
      {q: "L'ancora è (a + la) ___ prua.", a: "alla"},
      {q: "Siamo (in + lo) ___ stretto di Zara.", a: "nello"},
      {q: "I parabordi sono (a + la) ___ fiancata.", a: "alla"},
      {q: "Il sole scende (dietro + il) ___ monte.", a: "dietro il"}
    ],
    g3: [
      {q: "Domani (essere) ___ bel tempo.", a: "sarà"},
      {q: "Noi (partire) ___ alle otto.", a: "partiremo"},
      {q: "Il tour (finire) ___ a Osljak.", a: "finirà"},
      {q: "I clienti (fare) ___ il bagno.", a: "faranno"},
      {q: "Io (pulire) ___ la coperta dopo.", a: "pulirò"},
      {q: "Voi (vedere) ___ i delfini, spero!", a: "vedrete"},
      {q: "Tuo fratello (arrivare) ___ al molo.", a: "arriverà"},
      {q: "La barca (navigare) ___ verso sud.", a: "navigherà"},
      {q: "Noi (mangiare) ___ a bordo.", a: "mangeremo"},
      {q: "(Stare) ___ tutti bene oggi.", a: "staremo"}
    ]
  };

  function build() {
    for(let g=1; g<=3; g++) {
      const grid = document.getElementById('grid'+g);
      data['g'+g].forEach((item, i) => {
        grid.innerHTML += `<div class="ex-row"><span class="ex-num">${i+1}</span><span>${item.q.replace('___', `<input type="text" id="ex-${g}-${i}">`)}</span></div>`;
      });
    }
  }

  function checkGroup(g) {
    let score = 0;
    data['g'+g].forEach((item, i) => {
      const el = document.getElementById(`ex-${g}-${i}`);
      if(el.value.trim().toLowerCase() === item.a.toLowerCase()) {
        el.className = 'ok'; score++;
      } else { el.className = 'no'; }
    });
    const sDiv = document.getElementById('score'+g);
    sDiv.style.display = 'block';
    sDiv.innerHTML = score === 10 ? "🌟 Eccellente Sara! 10/10" : `Hai fatto ${score} su 10. Controlla le risposte in rosso!`;
    sDiv.style.color = score === 10 ? 'var(--green)' : 'var(--red)';
  }

  function showTab(id) {
    document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    event.currentTarget.classList.add('active');
  }

  build();
</script>
</body>
</html>
