<script>
function go(n,btn){
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nb').forEach(b=>b.classList.remove('active'));
  document.getElementById('p'+n).classList.add('active');
  btn.classList.add('active');
  for(let i=0;i<n;i++) document.getElementById('nb'+i).classList.add('done');
  window.scrollTo({top:0,behavior:'smooth'});
}

const scores={};const answered={};
const gMap={r1:'g1',r2:'g1',r3:'g1',l1:'g2',l2:'g2',l3:'g2',col1:'g3',col2:'g3',e1:'g4',e2:'g4',e3:'g4',e4:'g4'};
const gTot={g1:3,g2:3,g3:2,g4:4};
const sfMap={g1:'1',g2:'2',g3:'3',g4:'4'};

function mc(btn,qId,correct){
  if(answered[qId])return;
  answered[qId]=true;
  btn.parentElement.querySelectorAll('.o').forEach(o=>o.classList.add('disabled'));
  btn.classList.add(correct?'correct':'wrong');
  const g=gMap[qId];if(!g)return;
  if(!scores[g])scores[g]=0;
  if(correct)scores[g]++;
  const n=sfMap[g];
  document.getElementById('sf'+n).style.width=Math.round(scores[g]/gTot[g]*100)+'%';
  document.getElementById('sn'+n).textContent=scores[g]+'/'+gTot[g];
}

function norm(s){
  return s.trim().toLowerCase()
    .replace(/[.!?,]/g,'').replace(/à/g,'a').replace(/è/g,'e').replace(/é/g,'e')
    .replace(/ì/g,'i').replace(/ò/g,'o').replace(/ù/g,'u')
    .replace(/'/g,"'").replace(/\s+/g,' ');
}
function sf(input,answer,id){
  const v=norm(input.value);const a=norm(answer);
  const fb=document.getElementById('fb-'+id);
  if(v===a){
    input.classList.add('ok');input.classList.remove('err');
    if(fb){fb.textContent='✓ Perfetto!';fb.className='fb good';}
  } else if(v.length>1){
    input.classList.remove('ok');input.classList.add('err');
    if(fb)fb.className='fb';
  } else{input.classList.remove('ok','err');if(fb)fb.className='fb';}
}
function dg(input,answer,id){
  const v=norm(input.value);const a=norm(answer);
  if(v===a){input.classList.add('ok');input.classList.remove('err');}
  else if(v.length>1){input.classList.remove('ok');input.classList.add('err');}
  else input.classList.remove('ok','err');
}
function wc(el,id){
  const n=el.value.trim().split(/\s+/).filter(w=>w.length>0).length;
  document.getElementById(id).textContent=n+' parole';
}
function ins(id,text){
  const ta=document.getElementById(id);
  const sep=(ta.value&&!ta.value.endsWith(' ')&&!ta.value.endsWith('\n'))?'\n':'';
  ta.value+=sep+text;wc(ta,id==='pr1'?'wc1':'wc2');ta.focus();
}
let ss={};
function ac(chip,word,sbId){
  if(chip.classList.contains('used'))return;
  chip.classList.add('used');
  if(!ss[sbId])ss[sbId]=[];
  ss[sbId].push({word,chip});renderS(sbId);
}
function renderS(sbId){
  const box=document.getElementById(sbId);
  if(!ss[sbId]||!ss[sbId].length){box.textContent='Clicca le frasi per costruire il dialogo...';return;}
  box.innerHTML=ss[sbId].map((item,i)=>`<span class="bw" onclick="rw('${sbId}',${i})">${item.word}</span>`).join(' ');
}
function rw(sbId,idx){
  const item=ss[sbId][idx];
  if(item&&item.chip)item.chip.classList.remove('used');
  ss[sbId].splice(idx,1);renderS(sbId);
}
function rs(sbId,cpId){
  ss[sbId]=[];
  document.getElementById(sbId).textContent='Clicca le frasi per costruire il dialogo...';
  document.getElementById(cpId).querySelectorAll('.chip').forEach(c=>c.classList.remove('used'));
}
