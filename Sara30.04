<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sara · Lezione 26 · B1 Avanzato</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Instrument+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
  --night: #060E18;
  --deep: #0A1628;
  --hull: #112240;
  --wake: #1A3A5C;
  --horizon: #1E6B8A;
  --sea: #2E9AB5;
  --foam: #7ECFE3;
  --salt: #C8EBF2;
  --white: #F0F8FA;
  --gold: #C8953A;
  --gold-light: #F5E6C8;
  --coral: #C84B38;
  --coral-light: #F5DDD8;
  --green: #2A8A52;
  --green-light: #D8F0E5;
  --muted: #6A8FA8;
  --border: rgba(30,107,138,0.2);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Instrument Sans', sans-serif;
  background: var(--night);
  color: var(--white);
  font-size: 15px;
  line-height: 1.7;
  min-height: 100vh;
}

/* ── HERO ── */
.hero {
  position: relative;
  background: var(--deep);
  padding: 0;
  overflow: hidden;
  border-bottom: 1px solid var(--border);
}
.hero-bg {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 70% 30%, rgba(46,154,181,0.12) 0%, transparent 70%),
    radial-gradient(ellipse 50% 40% at 10% 80%, rgba(200,149,58,0.06) 0%, transparent 60%);
}
.wave-bar {
  height: 3px;
  background: repeating-linear-gradient(90deg,
    var(--sea) 0, var(--sea) 18px,
    var(--gold) 18px, var(--gold) 20px,
    transparent 20px, transparent 28px);
  opacity: 0.7;
}
.hero-inner {
  position: relative;
  max-width: 860px;
  margin: 0 auto;
  padding: 40px 24px 48px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 20px;
  align-items: end;
}
.hero-meta { display: flex; flex-direction: column; gap: 10px; }
.lesson-tag {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: 'Syne', sans-serif;
  font-size: 11px; font-weight: 600; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--sea);
}
.lesson-tag::before { content: ''; display: block; width: 20px; height: 1px; background: var(--sea); }
.hero h1 {
  font-family: 'Syne', sans-serif;
  font-size: clamp(28px, 5vw, 44px);
  font-weight: 800;
  line-height: 1.05;
  color: var(--white);
  letter-spacing: -0.02em;
}
.hero h1 span { color: var(--sea); }
.hero-sub { font-size: 13px; color: var(--muted); margin-top: 4px; }
.lesson-stats {
  display: flex; flex-direction: column; gap: 8px;
  align-items: flex-end;
}
.stat-pill {
  background: rgba(46,154,181,0.12);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 5px 14px;
  font-family: 'Syne', sans-serif;
  font-size: 11px; font-weight: 600;
  color: var(--foam); letter-spacing: 0.06em;
  white-space: nowrap;
}
.timer-pill {
  background: var(--gold);
  color: var(--deep);
  border-radius: 20px;
  padding: 5px 14px;
  font-family: 'Syne', sans-serif;
  font-size: 11px; font-weight: 700;
  letter-spacing: 0.06em;
}

/* ── NAV ── */
.nav-wrap {
  background: var(--hull);
  border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 100;
}
.nav-inner {
  max-width: 860px; margin: 0 auto;
  display: flex; gap: 2px; padding: 6px;
  overflow-x: auto;
  scrollbar-width: none;
}
.nav-inner::-webkit-scrollbar { display: none; }
.tab-btn {
  flex-shrink: 0;
  padding: 8px 16px;
  border: none; border-radius: 8px;
  background: transparent;
  font-family: 'Syne', sans-serif;
  font-size: 12px; font-weight: 600;
  letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--muted); cursor: pointer; transition: all 0.2s;
  white-space: nowrap;
}
.tab-btn:hover { background: rgba(46,154,181,0.1); color: var(--foam); }
.tab-btn.active { background: var(--sea); color: var(--deep); }
.tab-btn .mins {
  display: inline-block;
  background: rgba(0,0,0,0.2);
  border-radius: 10px; padding: 1px 6px;
  font-size: 9px; margin-left: 4px; vertical-align: middle;
}

/* ── WRAPPER ── */
.wrapper { max-width: 860px; margin: 0 auto; padding: 28px 20px 80px; }
.section { display: none; }
.section.active { display: block; }

/* ── CARDS ── */
.card {
  background: var(--hull);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 24px 28px;
  margin-bottom: 18px;
}
.card-label {
  font-family: 'Syne', sans-serif;
  font-size: 10px; font-weight: 700;
  letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--sea); margin-bottom: 10px;
}
.card h3 {
  font-family: 'Syne', sans-serif;
  font-size: 18px; font-weight: 700;
  color: var(--white); margin-bottom: 14px;
  letter-spacing: -0.01em;
}

/* ── BILINGUAL STYLE ── */
.bi-line {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  padding: 12px 16px;
  border-radius: 10px;
  margin-bottom: 8px;
  border-left: 3px solid var(--wake);
  background: rgba(17,34,64,0.6);
}
.bi-line.highlight { border-left-color: var(--sea); background: rgba(46,154,181,0.08); }
.bi-it { font-size: 15px; font-weight: 500; color: var(--white); }
.bi-it em { color: var(--sea); font-style: normal; font-weight: 600; }
.bi-en { font-size: 13px; color: var(--muted); font-style: italic; align-self: center; }
.bi-role {
  font-family: 'Syne', sans-serif;
  font-size: 9px; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--gold); display: block; margin-bottom: 3px;
}

/* ── NOTE BOX ── */
.note {
  background: rgba(200,149,58,0.1);
  border-left: 3px solid var(--gold);
  border-radius: 0 10px 10px 0;
  padding: 12px 16px; margin-bottom: 16px;
  font-size: 13px; line-height: 1.6;
  color: var(--gold-light);
}
.note strong {
  display: block; font-family: 'Syne', sans-serif;
  font-size: 9px; font-weight: 700;
  letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 4px;
}

/* ── VOCAB ── */
.vocab-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px,1fr)); gap: 10px; margin: 14px 0; }
.v-card {
  background: rgba(10,22,40,0.8);
  border: 1px solid var(--border);
  border-radius: 12px; padding: 14px 16px;
  cursor: pointer; transition: all 0.22s;
  position: relative; overflow: hidden;
}
.v-card::before {
  content: ''; position: absolute;
  top: 0; left: 0; right: 0; height: 2px;
  background: var(--sea); transform: scaleX(0);
  transition: transform 0.22s; transform-origin: left;
}
.v-card:hover { border-color: var(--sea); background: rgba(46,154,181,0.08); }
.v-card:hover::before { transform: scaleX(1); }
.v-card.open { border-color: var(--sea); background: rgba(46,154,181,0.1); }
.v-card.open::before { transform: scaleX(1); }
.v-it { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: var(--foam); }
.v-en { font-size: 12px; color: var(--muted); margin-top: 3px; }
.v-example { font-size: 12px; color: var(--salt); font-style: italic; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border); display: none; }
.v-card.open .v-example { display: block; }
.v-hint { font-size: 9px; color: var(--muted); text-align: right; margin-top: 6px; }

/* ── GRAMMAR TABLE ── */
.gram-wrap { overflow-x: auto; margin: 12px 0; }
.gram-table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 500px; }
.gram-table th {
  background: rgba(46,154,181,0.15);
  color: var(--sea); font-family: 'Syne', sans-serif;
  font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; padding: 9px 12px;
  text-align: left; border-bottom: 1px solid var(--border);
}
.gram-table td {
  padding: 9px 12px; border-bottom: 1px solid rgba(30,107,138,0.1);
  vertical-align: top;
}
.gram-table td:first-child { font-family: 'Syne', sans-serif; font-weight: 700; color: var(--sea); }

/* ── QUIZ ── */
.ex { margin-bottom: 22px; }
.ex .prompt {
  font-size: 15px; font-weight: 500;
  margin-bottom: 12px; line-height: 1.5;
  padding: 14px 16px;
  background: rgba(17,34,64,0.8);
  border-radius: 10px;
  border-left: 3px solid var(--wake);
}
.ex .prompt .sub { font-size: 12px; color: var(--muted); font-style: italic; display: block; margin-top: 4px; }
.opts { display: flex; flex-direction: column; gap: 8px; }
.opt {
  text-align: left; padding: 11px 16px;
  border: 1px solid var(--border); border-radius: 10px;
  background: rgba(10,22,40,0.6);
  font-family: 'Instrument Sans', sans-serif;
  font-size: 14px; color: var(--white);
  cursor: pointer; transition: all 0.18s;
}
.opt:hover:not(:disabled) { border-color: var(--sea); background: rgba(46,154,181,0.1); }
.opt.correct { background: rgba(42,138,82,0.15); border-color: var(--green); color: #8AE0B0; }
.opt.wrong { background: rgba(200,75,56,0.12); border-color: var(--coral); color: #F0A090; }
.fb {
  font-size: 13px; margin-top: 8px; padding: 10px 14px;
  border-radius: 9px; display: none; line-height: 1.6;
}
.fb.show { display: block; }
.fb.ok { background: rgba(42,138,82,0.12); color: #8AE0B0; border: 1px solid rgba(42,138,82,0.3); }
.fb.no { background: rgba(200,75,56,0.1); color: #F0A090; border: 1px solid rgba(200,75,56,0.25); }

/* ── FILL BLANK ── */
.fill-line { font-size: 15px; margin-bottom: 14px; line-height: 2.4; }
.blank {
  border: none; border-bottom: 2px solid var(--sea);
  background: transparent; color: var(--white);
  font-family: 'Instrument Sans', sans-serif;
  font-size: 15px; width: 140px; text-align: center; outline: none;
}
.blank.ok { border-color: var(--green); color: #8AE0B0; }
.blank.no { border-color: var(--coral); color: #F0A090; }
.btn {
  display: inline-block; margin-top: 12px;
  padding: 10px 22px; background: var(--sea);
  color: var(--deep); border: none; border-radius: 10px;
  font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 700;
  letter-spacing: 0.06em; cursor: pointer; transition: opacity 0.2s;
}

/* ── PROGRESS ── */
.progress-strip {
  display: flex; gap: 4px; margin-bottom: 24px;
  align-items: center;
}
.prog-seg {
  height: 4px; border-radius: 2px; flex: 1;
  background: var(--wake); transition: background 0.4s;
}
.prog-seg.done { background: var(--sea); }
.prog-label { font-family: 'Syne', sans-serif; font-size: 10px; font-weight: 700; color: var(--muted); margin-left: 8px; white-space: nowrap; }

/* ── TRANSLATION AREA ── */
textarea.ti {
  width: 100%; padding: 12px 14px;
  background: rgba(6,14,24,0.8);
  border: 1px solid var(--border); border-radius: 10px;
  font-family: 'Instrument Sans', sans-serif; font-size: 14px;
  color: var(--white); resize: vertical; min-height: 60px;
  margin-top: 6px;
}
.reveal-ans {
  display: inline-block; margin-top: 8px;
  padding: 7px 16px;
  background: transparent; border: 1px solid var(--border);
  border-radius: 8px; color: var(--muted);
  font-family: 'Syne', sans-serif; font-size: 11px; font-weight: 600;
  letter-spacing: 0.08em; cursor: pointer;
}

@media (max-width: 540px) {
  .bi-line { grid-template-columns: 1fr; }
  .bi-en { display: none; }
  .hero-inner { grid-template-columns: 1fr; }
  .lesson-stats { align-items: flex-start; flex-direction: row; flex-wrap: wrap; }
}
</style>
</head>
<body>

<div class="hero">
  <div class="wave-bar"></div>
  <div class="hero-bg"></div>
  <div class="hero-inner">
    <div class="hero-meta">
      <div class="lesson-tag">Lezione 26 · Capitano Sara</div>
      <h1>Italiano<br><span>in alto mare</span></h1>
      <p class="hero-sub">B1 Advanced · Nautical Italian · 50 minutes · bilingual EN/IT</p>
    </div>
    <div class="lesson-stats">
      <div class="stat-pill">B1 → B1+</div>
      <div class="stat-pill">⚓ 25 lezioni</div>
      <div class="timer-pill">⏱ 50 min</div>
    </div>
  </div>
</div>

<div class="nav-wrap">
  <div class="nav-inner">
    <button class="tab-btn active" onclick="goTab('warm')">Warm-up <span class="mins">8'</span></button>
    <button class="tab-btn" onclick="goTab('vocab')">Vocaboli <span class="mins">10'</span></button>
    <button class="tab-btn" onclick="goTab('grammar')">Grammatica <span class="mins">12'</span></button>
    <button class="tab-btn" onclick="goTab('esercizi')">Esercizi <span class="mins">10'</span></button>
    <button class="tab-btn" onclick="goTab('roleplay')">Role-play <span class="mins">10'</span></button>
  </div>
</div>

<div class="wrapper">

<div id="warm" class="section active">
  <div class="note"><strong>📋 Kate · warm-up</strong> After 25 lessons Sara can handle more complexity. Push her: ask for full sentences. Use the bilingual lines as reading prompts. Target: 3–4 sentences per answer.</div>
  <div class="card">
    <div class="card-label">Conversazione · 8 min</div>
    <h3>L'ultima navigazione</h3>
    <div class="bilingual">
      <div class="bi-line highlight">
        <div class="bi-it"><span class="bi-role">Insegnante</span><em>Raccontami</em> dell'ultima traversata. Com'erano le condizioni meteo?</div>
        <div class="bi-en">Tell me about your last crossing. What were the weather conditions like?</div>
      </div>
      <div class="bi-line">
        <div class="bi-it"><span class="bi-role">Insegnante</span>Hai avuto degli <em>imprevisti</em> a bordo? Come li hai gestiti?</div>
        <div class="bi-en">Did you have any unexpected problems on board? How did you handle them?</div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-label">Quick check</div>
    <div class="ex" id="wq1">
      <p class="prompt">Come si dice "the anchor has dragged" in italiano?</p>
      <div class="opts">
        <button class="opt" onclick="chk('wq1',this,false)">L'ancora è caduta</button>
        <button class="opt" onclick="chk('wq1',this,true)">L'ancora ha dragato</button>
      </div>
      <div class="fb" id="wq1-fb"></div>
    </div>
  </div>
</div>

<div id="vocab" class="section">
  <div class="card">
    <div class="card-label">Vocabolario · 10 min</div>
    <h3>Comunicare con autorevolezza</h3>
    <div class="vocab-grid" id="vg1"></div>
    <div class="vocab-grid" id="vg2"></div>
  </div>

  <div class="card">
    <div class="card-label">Collocazioni</div>
    <div class="ex" id="v_q1">
      <p class="prompt">___ una rotta alternativa</p>
      <div class="opts">
        <button class="opt" onclick="chk('v_q1',this,true)">tracciare</button>
        <button class="opt" onclick="chk('v_q1',this,false)">fare</button>
      </div>
      <div class="fb" id="v_q1-fb"></div>
    </div>
  </div>
</div>

<div id="grammar" class="section">
  <div class="card">
    <div class="card-label">Grammatica · 12 min</div>
    <h3>Il congiuntivo imperfetto</h3>
    <div class="gram-wrap">
      <table class="gram-table">
        <tr><th>Pronome</th><th>ESSERE</th><th>AVERE</th><th>-ARE (navigare)</th></tr>
        <tr><td>io/tu</td><td>fossi</td><td>avessi</td><td>navigassi</td></tr>
        <tr><td>lui/lei</td><td>fosse</td><td>avesse</td><td>navigasse</td></tr>
        <tr><td>loro</td><td>fossero</td><td>avessero</td><td>navigassero</td></tr>
      </table>
    </div>
    <div class="ex" id="gq1">
      <p class="prompt">Speravo che il mare ___ più calmo. (essere)</p>
      <div class="opts">
        <button class="opt" onclick="chk('gq1',this,true)">fosse</button>
        <button class="opt" onclick="chk('gq1',this,false)">era</button>
      </div>
      <div class="fb" id="gq1-fb"></div>
    </div>
  </div>
</div>

<div id="esercizi" class="section">
  <div class="card">
    <div class="card-label">Esercizio · Traduzione</div>
    <div id="trans-cont"></div>
  </div>
</div>

<div id="roleplay" class="section">
  <div class="card">
    <div class="card-label">Scenario</div>
    <h3>Il passeggero insoddisfatto</h3>
    <p>Gestisci il reclamo di un cliente sulla cabina usando un registro formale.</p>
  </div>
</div>

</div>

<script>
const tabs = ['warm','vocab','grammar','esercizi','roleplay'];

function goTab(name) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(name).classList.add('active');
  const activeBtn = document.querySelector(`.tab-btn[onclick="goTab('${name}')"]`);
  if(activeBtn) activeBtn.classList.add('active');
  window.scrollTo({top: 0, behavior: 'smooth'});
}

const v1 = [
  {it:'lamentarsi (di)', en:'to complain (about)', ex:'"I clienti si sono lamentati del rumore."'},
  {it:'gestire', en:'to handle / manage', ex:'"Ho gestito l\'emergenza con calma."'},
  {it:'rassicurare', en:'to reassure', ex:'"Ho rassicurato i passeggeri."'}
];

function buildVocab(data, id) {
  const g = document.getElementById(id);
  data.forEach(w => {
    const d = document.createElement('div');
    d.className = 'v-card';
    d.innerHTML = `<div class="v-it">${w.it}</div><div class="v-en">${w.en}</div><div class="v-example">${w.ex}</div><div class="v-hint">tap</div>`;
    d.onclick = () => d.classList.toggle('open');
    g.appendChild(d);
  });
}
buildVocab(v1, 'vg1');

const trans = [
  {en:'If the engine had not broken down, we would have arrived on time.', ans:'Se il motore non si fosse rotto, saremmo arrivati in orario.'}
];
const tc = document.getElementById('trans-cont');
trans.forEach((t,i) => {
  const d = document.createElement('div');
  d.innerHTML = `<p style="margin-bottom:8px;color:var(--salt);">"${t.en}"</p>
    <textarea class="ti" id="tr${i}"></textarea>
    <button class="reveal-ans" onclick="revT(${i},'${t.ans.replace(/'/g,"\\'")}')">Mostra risposta</button>
    <div class="fb" id="trfb${i}"></div>`;
  tc.appendChild(d);
});

function revT(i,a){const f=document.getElementById(`trfb${i}`);f.innerHTML=`<strong>Risposta:</strong> ${a}`;f.className='fb show ok';}

function chk(id, btn, correct) {
  const ex = document.getElementById(id);
  ex.querySelectorAll('.opt').forEach(b => b.disabled = true);
  btn.classList.add(correct ? 'correct' : 'wrong');
  const fb = document.getElementById(`${id}-fb`);
  fb.innerHTML = correct ? 'Corretto! ✓' : 'Riprova.';
  fb.className = `fb show ${correct?'ok':'no'}`;
}
</script>
</body>
</html>
